{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aiwmfrlwh/AI-shortform-alert/bill-alert-app/shorts-template/schema.json",
  "title": "법안톡 60초 법안 쇼츠 데이터",
  "description": "render.py가 읽는 쇼츠 문구. '**강조**' 표기는 hook.title_lines(파랑), what.summary_lines·next.lines(주황)에서만 색 강조로 바뀐다. 글자 수 한도는 prompt.md 참고(폭 초과는 render.py가 측정해 오류로 알려 줌).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "as_of", "category", "hook", "what", "status", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "파일명용 영문 ID (예: gb-tsg)"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "자료 기준일 YYYY-MM-DD. 화면에 'YYYY.MM.DD 기준'으로 표시"},
    "allow_middle_dot": {"type": "boolean", "description": "중간점 규칙 이전에 만든 영상을 그대로 재현할 때만 true. 새 법안에는 쓰지 않는다(기본 false: 화면 문구에 중간점이 있으면 렌더러가 오류로 멈춤)"},
    "category": {"type": "string", "minLength": 1, "maxLength": 10, "description": "관심 분야 칩 (예: 의료 보건). 중간점 금지"},
    "bill_meta": {
      "type": "object",
      "description": "화면에는 안 나오는 메타데이터(앱 연동·검수용)",
      "additionalProperties": false,
      "properties": {
        "official_name": {"type": "string"},
        "bill_no": {"type": "string"},
        "proposer": {"type": "string"},
        "proposed_date": {"type": "string"},
        "committee": {"type": "string"},
        "assembly": {"type": "string"}
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_lines", "bill_name", "status"],
      "properties": {
        "title_lines": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}, "description": "후킹 제목, 줄마다 하나. **강조** 가능"},
        "bill_name": {"type": "string", "minLength": 1, "description": "법안 이름(짧게). 뒤에 ', YYYY.MM.DD 기준'이 자동으로 붙음"},
        "status": {"type": "string", "minLength": 1, "description": "현재 상태 한 줄. 앞에 '현재: '가 자동으로 붙음"}
      }
    },
    "what": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_lines"],
      "properties": {
        "summary_lines": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}, "description": "한 문장 요약을 줄로 나눈 것. **강조** 가능"},
        "cards": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": {"type": "string"},
              "lines": {"type": "array", "maxItems": 2, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "pro": {"$ref": "#/$defs/pro"},
    "con": {"$ref": "#/$defs/con"},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "chip"],
      "properties": {
        "stage": {"type": "integer", "minimum": 0, "maximum": 5, "description": "0 발의, 1 소관위 회부, 2 소관위 심사, 3 법사위 심사, 4 본회의, 5 정부 이송과 공포"},
        "chip": {"type": "string", "minLength": 1, "maxLength": 6, "description": "현재 단계 옆 주황 칩 (예: 심사 중, 보류, 계류)"},
        "labels": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "minLength": 1}, "description": "단계 이름 6개(생략 시 기본값). 소관위가 법사위인 경우 등에만 바꿈"},
        "details": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}, "description": "단계별 보조 설명 6개(모르면 빈 문자열)"}
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": {"type": "array", "maxItems": 3, "items": {"type": "string"}, "description": "다음 절차 설명. **강조** 가능. 비우면 일반 알림 안내로 대체"},
        "note": {"type": "string"},
        "cta_note": {"type": "string", "description": "알림 버튼 아래 한 줄"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["outlet"],
        "properties": {
          "outlet": {"type": "string", "minLength": 1, "description": "매체/기관 이름 (화면 출처 줄에 표시)"},
          "title": {"type": "string"},
          "url": {"type": "string", "description": "기사 URL (prompt로 생성할 때는 필수로 채움)"},
          "date": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "pro": {
      "type": "object",
      "additionalProperties": false,
      "description": "찬성 측. 자료가 없으면 객체 전체를 생략(또는 빈 값). 반대 측과 함께 있어야 장면이 나옴",
      "properties": {
        "who": {"type": "string", "description": "찬성 주체. 칩에 '찬성: '이 자동으로 붙음"},
        "quote_lines": {"type": "array", "maxItems": 2, "items": {"type": "string"}, "description": "핵심 주장 요지, 따옴표는 자동"},
        "cards": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": {"type": "string"},
              "value": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "note": {"type": "string", "description": "작은 각주 (예: 수치 출처 명시)"}
      }
    },
    "con": {
      "type": "object",
      "additionalProperties": false,
      "description": "반대 측. 찬성 측과 대칭",
      "properties": {
        "who": {"type": "string"},
        "quote_lines": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
        "cards": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "lines": {"type": "array", "maxItems": 2, "items": {"type": "string"}}
            }
          }
        },
        "note": {"type": "string", "description": "파란 한 줄 (예: 상대측 보완책·쟁점 정리)"}
      }
    }
  }
}
